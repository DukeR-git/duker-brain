# Copy to .env and adjust. scripts/host_preflight.sh can generate this for you:
#   ./scripts/host_preflight.sh --write-env

# --- Networking and access -------------------------------------------------
# 127.0.0.1 keeps the service on this machine (the default). To reach it from
# other machines, set 0.0.0.0 AND a key below - without one, anyone who can
# reach the port can use the GPU.
LAYA_BIND_HOST=127.0.0.1
LAYA_PORT=8081
# Any long random string, e.g. `openssl rand -hex 32`. Clients send it as
# BRAIN_DECISIONS_API_KEY. Empty = no auth.
LAYA_API_KEY=

# --- GPU access ------------------------------------------------------------
# Must match the host. Find them with:
#   getent group render | cut -d: -f3
#   getent group video  | cut -d: -f3
RENDER_GID=993
VIDEO_GID=44

# To restrict Laya to one device when llama.cpp owns another, uncomment
# ZE_AFFINITY_MASK in docker-compose.yml and set an index there. Do not set it
# to an empty string - Level Zero would then expose no devices at all.

# --- Model -----------------------------------------------------------------
LAYA_CHECKPOINT=english
LAYA_REPO_ID=convaiinnovations/laya
# Only for a direct-load fallback of a non-English checkpoint; normally empty.
LAYA_REPO_SUBFOLDER=
LAYA_SERVED_MODEL_NAME=laya-english

# xpu | cuda | cpu | auto
LAYA_DEVICE=xpu
# auto (= checkpoint fp32) | bfloat16 | float16 | float32
LAYA_DTYPE=auto
# false makes startup hard-fail if the Arc card is not usable, instead of
# silently serving 200ms CPU inference.
LAYA_ALLOW_CPU_FALLBACK=true

# --- Behaviour -------------------------------------------------------------
LAYA_WARMUP_ITERATIONS=3
# A decision slower than this returns 504 instead of holding the client open.
LAYA_REQUEST_TIMEOUT_S=30
LAYA_CHOICE_OPTION_LIMIT=15
LAYA_CHOICE_OPTION_LIMIT_ENFORCE=false
# passthrough hands structured `state` to Laya as-is; json flattens it to text first.
LAYA_STATE_MODE=passthrough
LAYA_LOG_LEVEL=INFO
# One log line per decision: the winning label and its confidence.
LAYA_LOG_DECISIONS=true
