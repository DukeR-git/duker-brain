{
  "name": "brain-traverse",
  "version": "1.1.0",
  "private": true,
  "description": "Dynamic context routing for coding agents: walks a hierarchical Obsidian vault with a System-1 decision model (TypeSafe Jev or a self-hosted Laya) and injects only the reference note that applies. A Pi package, plus an MCP server for Claude Code, Codex and others.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "mcp",
    "obsidian",
    "context-routing",
    "jev",
    "laya"
  ],
  "author": "DukeR-git",
  "license": "MIT",
  "homepage": "https://github.com/DukeR-git/duker-brain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DukeR-git/duker-brain.git"
  },
  "bugs": {
    "url": "https://github.com/DukeR-git/duker-brain/issues"
  },
  "workspaces": [
    "brain-core",
    "pi-traverser",
    "brain-keeper"
  ],
  "pi": {
    "extensions": [
      "./pi-traverser/index.ts",
      "./brain-keeper/pi.ts"
    ],
    "prompts": [
      "./brain-keeper/commands/brain-capture.md",
      "./brain-keeper/commands/brain-research.md"
    ]
  },
  "bin": {
    "brain-keeper": "./brain-keeper/bin/brain-keeper.mjs",
    "brain-traverse": "./pi-traverser/bin/brain-traverse.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "keeper": "node brain-keeper/bin/brain-keeper.mjs",
    "traverse": "node pi-traverser/bin/brain-traverse.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
