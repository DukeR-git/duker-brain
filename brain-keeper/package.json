{
  "name": "brain-keeper",
  "version": "1.1.0",
  "private": true,
  "description": "MCP server and CLI for adding to, maintaining and improving the brain-tree knowledge vault. Works with Pi, Claude Code, Codex and any other MCP client.",
  "author": "DukeR-git",
  "license": "MIT",
  "homepage": "https://github.com/DukeR-git/duker-brain/tree/main/brain-keeper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DukeR-git/duker-brain.git",
    "directory": "brain-keeper"
  },
  "bugs": {
    "url": "https://github.com/DukeR-git/duker-brain/issues"
  },
  "type": "module",
  "main": "src/server.ts",
  "bin": {
